rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check user role
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Events: Publicly readable, write restricted to authenticated organizers/admins
    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null && getUserData().role in ['organizer', 'admin'];
      allow update, delete: if request.auth != null && (resource.data.organizerId == request.auth.uid || getUserData().role == 'admin');
    }
    
    // Tickets: Users can read/create their own. Organizers of the associated event can read/update (for scanner check-in). Admins can read all.
    match /tickets/{ticketId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.organizerId == request.auth.uid ||
        getUserData().role == 'admin'
      );
      
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.organizerId == request.auth.uid ||
        getUserData().role == 'admin'
      );
      
      allow delete: if request.auth != null && getUserData().role == 'admin';
    }
    
    // Users: Users can read/write their own profile data. Admins can read all profiles.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || getUserData().role == 'admin');
      allow create: if request.auth != null && request.auth.uid == userId && (
        // Organizers must start as unapproved
        (request.resource.data.role == 'organizer' && request.resource.data.approved == false) ||
        (request.resource.data.role != 'organizer')
      );
      allow update: if request.auth != null && (
        getUserData().role == 'admin' ||
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          (
            (!('approved' in request.resource.data) && !('approved' in resource.data)) ||
            (request.resource.data.approved == resource.data.approved)
          )
        )
      );
      allow delete: if request.auth != null && getUserData().role == 'admin';
    }

    // Trails: Publicly readable, write restricted to admins.
    match /trails/{trailId} {
      allow read: if true;
      allow write: if request.auth != null && getUserData().role == 'admin';
    }

    // Platform Settings: Readable by any authenticated user, writable by admins only.
    match /platformSettings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && getUserData().role == 'admin';
    }

    // Organizer Fee Overrides: Readable by any authenticated user, writable by admins only.
    match /organizerFees/{orgId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && getUserData().role == 'admin';
    }

    // Completed Trails (Rewards): Users can read their own. Organizers and admins can write (triggered by gate scan check-in).
    match /users/{userId}/completedTrails/{trailId} {
      allow read: if request.auth != null && (request.auth.uid == userId || getUserData().role == 'admin');
      allow create: if request.auth != null && getUserData().role in ['organizer', 'admin'];
      allow update, delete: if request.auth != null && getUserData().role == 'admin';
    }
  }
}
